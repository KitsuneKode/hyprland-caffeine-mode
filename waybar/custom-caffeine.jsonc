{
  "custom/caffeine": {
    "return-type": "json",
    "format": "{text}",
    "exec": "CAFFEINE_ACTIVE_TEXT='󰅶' CAFFEINE_INACTIVE_TEXT='󰾪' idle-inhibitor-status.sh",
    "interval": "once",
    "signal": 20,
    "tooltip": true,
    "on-click": "idle-inhibitor-toggle.sh toggle",
    "on-click-right": "idle-inhibitor-toggle.sh off",
  },
}
